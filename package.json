{
  "name": "diagram-chat",
  "displayName": "Diagram Chat",
  "description": "Interactive Mermaid diagrams and Apache ECharts charts beside VS Code chat: draw with your chat agent and edit diagrams in Markdown.",
  "version": "0.11.0",
  "publisher": "fornwall",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fornwall/diagram"
  },
  "engines": {
    "vscode": "^1.145.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "ECharts options with JavaScript code need a trusted workspace."
    },
    "virtualWorkspaces": true
  },
  "categories": [
    "AI",
    "Chat",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:diagram.panel",
    "onLanguage:markdown"
  ],
  "contributes": {
    "chatAgents": [
      {
        "path": "./agents/diagram.agent.md"
      }
    ],
    "languageModelTools": [
      {
        "name": "diagram_render",
        "displayName": "Render Diagram or Chart",
        "toolReferenceName": "diagram",
        "canBeReferencedInPrompt": true,
        "icon": "$(type-hierarchy)",
        "userDescription": "Show a Mermaid diagram or an ECharts chart in an interactive panel",
        "modelDescription": "Show a Mermaid diagram or an Apache ECharts option in the panel beside chat, replacing the current one. The user can select items, edit the source and ask follow-ups. Returns the diagram type, or the render error to fix.",
        "tags": [
          "diagram",
          "mermaid",
          "echarts",
          "chart",
          "visualization"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "description": "Complete Mermaid source, or an ECharts option as JSON or a JavaScript object literal (functions allowed). The panel applies the VS Code theme; add colors and fonts only when they carry meaning."
            },
            "file": {
              "type": "string",
              "description": "Instead of source, a file holding it (absolute or relative to the workspace), such as a .mmd file or an ECharts option."
            },
            "language": {
              "type": "string",
              "enum": [
                "mermaid",
                "echarts"
              ],
              "description": "Defaults to \"echarts\" for a source starting with \"{\", else \"mermaid\"."
            },
            "title": {
              "type": "string",
              "description": "Short title shown in the panel."
            },
            "clickPrompt": {
              "type": "string",
              "description": "Chat request sent when the user clicks an item, with {label} replaced, e.g. \"Explain {label}\"."
            },
            "links": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Mermaid node ids mapped to code locations that clicking opens, e.g. {\"parse\": \"src/parser.ts#L42-L60\"}."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "diagram_edit",
        "displayName": "Edit Current Diagram",
        "toolReferenceName": "diagramEdit",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "userDescription": "Change the current diagram or chart with exact replacements in its source",
        "modelDescription": "Change the current diagram or chart with exact text replacements in its source, keeping the rest, including the user's edits. All edits apply or none do. Returns what changed, or the render error.",
        "tags": [
          "diagram",
          "mermaid",
          "echarts",
          "chart",
          "visualization"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "edits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "oldText": {
                    "type": "string",
                    "description": "Exact text in the source, occurring once unless replaceAll."
                  },
                  "newText": {
                    "type": "string",
                    "description": "The replacement; empty deletes oldText."
                  },
                  "replaceAll": {
                    "type": "boolean",
                    "description": "true replaces every occurrence."
                  }
                },
                "required": [
                  "oldText",
                  "newText"
                ],
                "additionalProperties": false
              },
              "maxItems": 50,
              "description": "Replacements made in order; keep each oldText short but unique."
            },
            "title": {
              "type": "string",
              "description": "New panel title."
            },
            "links": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": "Code links to add or change by node id, as in diagram_render; null removes one."
            }
          },
          "required": [
            "edits"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "diagram_getState",
        "displayName": "Get Diagram",
        "toolReferenceName": "diagramState",
        "canBeReferencedInPrompt": true,
        "icon": "$(eye)",
        "userDescription": "Read the diagram in the panel, with your edits and selection",
        "modelDescription": "Read the current diagram or chart: its source, errors, warnings, the user's edits since the agent's last change, marks, and the items the user selected.",
        "tags": [
          "diagram",
          "mermaid",
          "echarts",
          "chart",
          "visualization"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "diagram_getImage",
        "displayName": "View Diagram",
        "toolReferenceName": "diagramImage",
        "canBeReferencedInPrompt": true,
        "icon": "$(file-media)",
        "userDescription": "Show the model an image of the diagram or chart in the diagram panel",
        "modelDescription": "Return a PNG of the current drawing as the panel shows it, to check layout and readability. Give ids to zoom in on part of it.",
        "tags": [
          "diagram",
          "mermaid",
          "echarts",
          "chart",
          "visualization"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Show only the part around these items: node ids, edges as \"A --> B\", or chart item names."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "diagram_annotate",
        "displayName": "Mark Up Diagram",
        "toolReferenceName": "diagramAnnotate",
        "canBeReferencedInPrompt": true,
        "icon": "$(pin)",
        "userDescription": "Mark nodes, edges, sequence messages or chart items without drawing again",
        "modelDescription": "Mark items of the current drawing, with optional callouts, without changing its source. Each call replaces earlier marks; omit marks to clear them.",
        "tags": [
          "diagram",
          "mermaid",
          "echarts",
          "chart",
          "visualization"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "marks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Node id, edge as \"A --> B\" (or \"A --> B: label\"), or chart item name."
                  },
                  "mark": {
                    "type": "string",
                    "enum": [
                      "current",
                      "problem",
                      "good",
                      "info"
                    ],
                    "description": "\"current\" (default), \"problem\", \"good\" or \"info\"."
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "description": "Short plain-text callout beside this item."
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              "description": "Omit or pass [] to clear the marks.",
              "maxItems": 50
            },
            "dim": {
              "type": "boolean",
              "description": "Fade unmarked items. Defaults to false."
            },
            "focus": {
              "type": "boolean",
              "description": "Pan to the marked items."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "diagram_guide",
        "displayName": "Diagram Guide",
        "toolReferenceName": "diagramGuide",
        "canBeReferencedInPrompt": true,
        "icon": "$(book)",
        "userDescription": "Look up how to draw a kind of Mermaid diagram or ECharts chart well",
        "modelDescription": "Syntax notes, working examples and pitfalls for a Mermaid diagram type or ECharts chart kind. Omit topic to list topics.",
        "tags": [
          "diagram",
          "mermaid",
          "echarts",
          "chart",
          "visualization"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "maxLength": 1000,
              "description": "e.g. \"flowchart\", \"sequence\", \"architecture\", \"echarts\" or \"echarts-bar\"."
            }
          },
          "additionalProperties": false
        }
      }
    ],
    "commands": [
      {
        "command": "diagram.show",
        "title": "Show Panel",
        "category": "Diagram"
      },
      {
        "command": "diagram.openAtCursor",
        "title": "Open Diagram at Cursor",
        "category": "Diagram"
      },
      {
        "command": "diagram.export",
        "title": "Export…",
        "category": "Diagram",
        "icon": "$(export)"
      },
      {
        "command": "diagram.clearSelection",
        "title": "Clear Selection",
        "category": "Diagram"
      },
      {
        "command": "diagram.help",
        "title": "Help",
        "category": "Diagram"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "diagram.openAtCursor",
          "when": "editorLangId == markdown"
        },
        {
          "command": "diagram.export",
          "when": "diagram.hasDiagram"
        },
        {
          "command": "diagram.clearSelection",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "diagram.openAtCursor",
          "when": "editorLangId == markdown && diagram.editorHasDiagram",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "diagram.export",
          "when": "activeWebviewPanelId == diagram.panel && diagram.hasDiagram",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "diagram.clearSelection",
          "when": "webviewId == diagram.panel && diagram.canClearSelection",
          "group": "0_selection@2"
        },
        {
          "command": "diagram.export",
          "when": "webviewId == diagram.panel && webviewSection == drawing && diagram.hasDiagram",
          "group": "1_export"
        },
        {
          "command": "diagram.help",
          "when": "webviewId == diagram.panel",
          "group": "9_help"
        }
      ]
    },
    "configuration": {
      "title": "Diagram",
      "properties": {
        "diagram.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Show an **Open in Diagram** action above every `mermaid` and `echarts` code block and `::: mermaid` container in a Markdown file, which opens the diagram in the panel. The **Diagram: Open Diagram at Cursor** command opens one without it."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run compile -- --production",
    "analyze": "node esbuild.mjs --production --analyze",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check --error-on-warnings",
    "format": "biome check --write",
    "compile-tests": "node -e \"fs.rmSync('out',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "pretest": "npm run compile && npm run compile-tests",
    "test": "vscode-test",
    "vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.145.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "d3-transition": "^3.0.2",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "katex": "0.19.1",
    "mermaid": "^12.3.0",
    "ovsx": "1.4.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "katex": "$katex",
    "mocha": {
      "diff": "^9.0.0",
      "serialize-javascript": "^7.1.4"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  },
  "keywords": [
    "mermaid",
    "echarts",
    "diagram",
    "chart",
    "flowchart",
    "sequence diagram",
    "visualization",
    "markdown",
    "chat",
    "copilot",
    "ai",
    "graph"
  ]
}
